# Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Discord Developer Portal → General Information → Application ID
CLIENT_ID=

# Optional: use a server ID to register slash commands instantly in one test server.
# Leave blank to register global commands.
GUILD_ID=

# Groq Console → API Keys
GROQ_API_KEY=

# Character and model
CHARACTER_NAME=Mika
GROQ_MODEL=llama-3.3-70b-versatile

# Runtime and conversation memory
DATA_DIR=./data
MAX_HISTORY_MESSAGES=12
MEMORY_TTL_DAYS=30
COOLDOWN_MS=5000
MAX_INPUT_CHARS=1500
MAX_OUTPUT_TOKENS=220
LOG_LEVEL=info
